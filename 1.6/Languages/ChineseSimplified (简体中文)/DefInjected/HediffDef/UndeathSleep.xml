  <!-- EN: regenerating -->
  <OWD_UndeathSleep.stages.regenerating-0.label>再生中</OWD_UndeathSleep.stages.regenerating-0.label>
  <!-- EN: regenerating -->
  <OWD_UndeathSleep.stages.regenerating-1.label>再生中</OWD_UndeathSleep.stages.regenerating-1.label>
  
